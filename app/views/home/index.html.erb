<div class="container my-5">
  <!-- Hero Callout Section -->
  <div class="bg-dark text-white text-center py-5 mb-5 rounded-3 border border-secondary shadow-sm">
    <div class="container py-3">
      <h1 class="display-5 fw-extrabold mb-3 tracking-tight">Track Your Crypto Assets Globally</h1>
      <p class="lead text-white-50 max-width-md mx-auto mb-4">Monitor live token pricing, macro market capitalisation, and map individual holding analytics securely in real-time.</p>
      <div class="d-flex justify-content-center gap-3">
        <%= link_to 'Create Free Account', new_user_registration_path, class: 'btn btn-primary btn-lg px-4 fw-semibold shadow-xs' %>
        <%= link_to 'Sign In to Account', new_user_session_path, class: 'btn btn-outline-light btn-lg px-4' %>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h3 fw-bold text-dark mb-1">Global Cryptocurrency Market Overview</h2>
      <p class="text-secondary small mb-0">Public directory dashboard index — Register an account to begin custom ledger tracking</p>
    </div>
    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">● Market Live</span>
  </div>

  <!-- Main Grid Mock Ledger Table Container -->
  <div class="card border-0 shadow-xs rounded-3 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 border-bottom border-light">
      <h5 class="mb-0 fw-bold text-dark text-sm">Monitored Assets Allocation Ledger</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-uppercase fw-bold text-xs tracking-wider text-secondary border-bottom">
          <tr>
            <th class="ps-4 py-3">Asset Allocation</th>
            <th class="text-end">Market Capitalisation</th>
            <th class="text-end">Token Price</th>
            <th class="text-center">1h / 24h / 7d Trends</th>
            <th class="text-end">Quantity Owned</th>
            <th class="text-end">Holding Valuation</th>
            <th class="text-end">Net Position ROI</th>
            <th class="text-center">Weight</th>
            <th class="pe-4 text-end">Action Controls</th>
          </tr>
        </thead>
        <tbody class="text-sm text-secondary">
          <% 
            # Static mock dataset mirroring database architecture fields safely for guests
            mock_market_coins = [
              { name: "Bitcoin", symbol: "BTC", price: 74546.00, cap: 1450000000000, h1: 0.4, h24: 2.1, d7: -1.5 },
              { name: "Ethereum", symbol: "ETH", price: 2610.50, cap: 312800000000, h1: -0.2, h24: 1.8, d7: 4.2 },
              { name: "Solana", symbol: "SOL", price: 184.25, cap: 86400000000, h1: 1.1, h24: -0.5, d7: 8.9 }
            ]
          %>

          <% mock_market_coins.each do |coin| %>
            <tr>
              <!-- Asset Symbol Layout -->
              <td class="ps-4 py-3">
                <div class="d-flex align-items-center gap-3">
                  <span class="d-inline-flex align-items-center justify-content-center bg-dark text-white fw-bold rounded-2 px-2 py-1 text-xs font-monospace shadow-xs" style="min-width: 42px;"><%= coin[:symbol] %></span>
                  <div>
                    <span class="fw-bold text-dark d-block mb-0.5"><%= coin[:name] %></span>
                    <div class="text-secondary text-xs text-uppercase font-monospace fw-medium"><%= coin[:symbol] %></div>
                  </div>
                </div>
              </td>
              
              <!-- Macro Capitalization -->
              <td class="text-end font-monospace">
                $<%= number_to_human(coin[:cap], units: { thousand: 'K', million: 'M', billion: 'B', trillion: 'T' }, precision: 2) %>
              </td>

              <!-- Price Metric -->
              <td class="text-end fw-semibold text-dark font-monospace">
                <%= number_to_currency(coin[:price], precision: 2) %>
              </td>
              
              <!-- Delta Percentage Timeline -->
              <td class="text-center">
                <div class="d-inline-flex align-items-center gap-1 font-monospace text-xs fw-semibold px-2 py-1 rounded bg-light border">
                  <span class="<%= coin[:h1] >= 0 ? 'text-success' : 'text-danger' %>"><%= coin[:h1] >= 0 ? "+" : "" %><%= coin[:h1] %>%</span>
                  <span class="text-muted opacity-50 px-0.5">/</span>
                  <span class="<%= coin[:h24] >= 0 ? 'text-success' : 'text-danger' %>"><%= coin[:h24] >= 0 ? "+" : "" %><%= coin[:h24] %>%</span>
                  <span class="text-muted opacity-50 px-0.5">/</span>
                  <span class="<%= coin[:d7] >= 0 ? 'text-success' : 'text-danger' %>"><%= coin[:d7] >= 0 ? "+" : "" %><%= coin[:d7] %>%</span>
                </div>
              </td>

              <!-- Blurred/Locked user fields out to indicate registration requirement -->
              <td class="text-end font-monospace text-muted opacity-50">🔒 Locked</td>
              <td class="text-end font-monospace text-muted opacity-50">🔒 Locked</td>
              <td class="text-end font-monospace text-muted opacity-50">🔒 Locked</td>
              <td class="text-center font-monospace text-muted opacity-50">-</td>

              <!-- Action Prompt routing them to signup -->
              <td class="pe-4 text-end">
                <%= link_to 'Track Asset', new_user_registration_path, class: "btn btn-xs btn-outline-primary fw-semibold rounded-2 px-3 py-1 text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
