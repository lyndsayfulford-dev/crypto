<div class="container my-5">
  <!-- Flash Notification Banners Layout -->
  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
      <div class="d-flex align-items-center gap-2">
        <span>✨</span> <%= flash[:notice] %>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="alert alert-warning alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
      <div class="d-flex align-items-center gap-2">
        <span>⚠️</span> <%= flash[:alert] %>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <!-- Section Dashboard Header Elements -->
  <div class="row align-items-center justify-content-between g-3 mb-5">
    <div class="col-12 col-md-auto">
      <h1 class="h2 fw-extrabold text-dark tracking-tight mb-1">Portfolio Overview</h1>
      <p class="text-secondary small mb-0">Real-time valuation analytics generated via Rails 8 framework architecture</p>
    </div>
    <div class="col-12 col-md-auto">
      <div class="d-flex align-items-center gap-2">
        <%= button_to refresh_prices_path, method: :post, class: "btn btn-white text-dark border border-gray-300 d-inline-flex align-items-center gap-2 px-3 py-2 shadow-xs fw-semibold rounded-2 transition-all" do %>
          <span>🔄</span> Refresh Market Rates
        <% end %>
        <%= link_to new_coin_path, class: "btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-xs fw-semibold rounded-2" do %>
          <span>+</span> Add New Asset
        <% end %>
      </div>
    </div>
  </div>

  <!-- Macro Metric Portfolio Highlights Summary Cards -->
  <div class="row g-4 mb-5">
    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card h-100 border-0 shadow-xs bg-white rounded-3 p-4">
        <div class="text-uppercase text-secondary tracking-wider fw-bold text-xs mb-2">Total Combined Cost</div>
        <div class="h2 fw-bold text-dark mb-0 font-monospace"><%= number_to_currency(@total_investment) %></div>
      </div>
    </div>
    
    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card h-100 border-0 shadow-xs bg-white rounded-3 p-4">
        <div class="text-uppercase text-secondary tracking-wider fw-bold text-xs mb-2">Current Value Index</div>
        <div class="h2 fw-bold text-primary mb-0 font-monospace"><%= number_to_currency(@current_portfolio_value) %></div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="card h-100 border-0 shadow-xs rounded-3 p-4 <%= @net_profit_loss >= 0 ? 'bg-success-subtle border-start border-success border-4' : 'bg-danger-subtle border-start border-danger border-4' %>">
        <div class="text-uppercase text-secondary tracking-wider fw-bold text-xs mb-2">Net Portfolio Returns</div>
        <div class="h2 fw-bold mb-0 font-monospace <%= @net_profit_loss >= 0 ? 'text-success' : 'text-danger' %>">
          <%= @net_profit_loss >= 0 ? "+" : "" %><%= number_to_currency(@net_profit_loss) %>
          <span class="fs-6 fw-normal text-secondary opacity-75">(<%= number_to_percentage(@percentage_return, precision: 2) %>)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Grid Holdings Interactive Ledger Table Container -->
  <div class="card border-0 shadow-xs rounded-3 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 border-bottom border-light">
      <h5 class="mb-0 fw-bold text-dark text-sm">Monitored Assets Allocation Allocation Ledger</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-uppercase fw-bold text-xs tracking-wider text-secondary border-bottom">
          <tr>
            <th class="ps-4 py-3">Asset Allocation</th>
            <th class="text-end">Market Capitalisation</th>
            <th class="text-end">Token Price</th>
            <th class="text-center">1h / 24h / 7d Trends</th>
            <th class="text-end">Quantity Owned</th>
            <th class="text-end">Holding Valuation</th>
            <th class="text-end">Net Position ROI</th>
            <th class="text-center">Weight</th>
            <th class="pe-4 text-end">Action Controls</th>
          </tr>
        </thead>
        <tbody class="text-sm">
          <% if @coins.any? %>
            <% @coins.each do |coin| %>
              <%# Core Data Calculations Logic Processing Scope %>
              <% total_cost = coin.amount_owned * coin.cost_per_coin %>
              <% total_value = coin.amount_owned * coin.price %>
              <% individual_return = total_value - total_cost %>
              <% individual_percentage = total_cost.positive? ? (individual_return / total_cost) * 100 : 0 %>
              <% portfolio_weight = @current_portfolio_value.positive? ? (total_value / @current_portfolio_value) * 100 : 0 %>

              <tr class="transition-all">
                <!-- Asset Symbol and Link Layout -->
                <td class="ps-4 py-3">
                  <div class="d-flex align-items-center gap-3">
                    <span class="d-inline-flex align-items-center justify-content-center bg-dark text-white fw-bold rounded-2 px-2 py-1 text-xs font-monospace shadow-xs" style="min-width: 42px;"><%= coin.symbol %></span>
                    <div>
                      <%= link_to coin.name, edit_coin_path(coin), class: "fw-bold text-dark text-decoration-none hover-link-primary transition-colors d-block mb-0.5" %>
                      <div class="text-secondary text-xs text-uppercase font-monospace fw-medium"><%= coin.symbol %></div>
                    </div>
                  </div>
                </td>
                
                <!-- Macro Capitalization Figure Value -->
                <td class="text-end text-secondary font-monospace">
                  $<%= number_to_human(coin.market_cap, units: { thousand: 'K', million: 'M', billion: 'B', trillion: 'T' }, precision: 2) %>
                </td>

                <!-- Live Price Metric -->
                <td class="text-end fw-semibold text-dark font-monospace">
                  <%= number_to_currency(coin.price, precision: coin.price < 1 ? 4 : 2) %>
                </td>
                
                <!-- Clean Inline Delta Percentage Timeline Block -->
                <td class="text-center">
                  <div class="d-inline-flex align-items-center gap-1 font-monospace text-xs fw-semibold px-2 py-1 rounded bg-light border">
                    <span class="<%= coin.percent_change_1h >= 0 ? 'text-success' : 'text-danger' %>">
                      <%= coin.percent_change_1h >= 0 ? "+" : "" %><%= number_to_percentage(coin.percent_change_1h, precision: 1) %>
                    </span>
                    <span class="text-muted opacity-50 px-0.5">/</span>
                    <span class="<%= coin.percent_change_24h >= 0 ? 'text-success' : 'text-danger' %>">
                      <%= coin.percent_change_24h >= 0 ? "+" : "" %><%= number_to_percentage(coin.percent_change_24h, precision: 1) %>
                    </span>
                    <span class="text-muted opacity-50 px-0.5">/</span>
                    <span class="<%= coin.percent_change_7d >= 0 ? 'text-success' : 'text-danger' %>">
                      <%= coin.percent_change_7d >= 0 ? "+" : "" %><%= number_to_percentage(coin.percent_change_7d, precision: 1) %>
                    </span>
                  </div>
                </td>

                <!-- Wallet Token Count Metric -->
                <td class="text-end text-dark font-monospace fw-medium">
                  <%= coin.amount_owned %>
                  <div class="text-secondary text-xs font-normal">Avg: <%= number_to_currency(coin.cost_per_coin) %></div>
                </td>

                <!-- Gross Position Asset Worth -->
                <td class="text-end text-dark font-monospace fw-bold">
                  <%= number_to_currency(total_value) %>
                </td>
                
                <!-- Calculated Allocation Returns Summary Block -->
                <td class="text-end">
                  <span class="fw-bold d-block font-monospace <%= individual_return >= 0 ? 'text-success' : 'text-danger' %>">
                    <%= individual_return >= 0 ? "+" : "" %><%= number_to_currency(individual_return) %>
                  </span>
                  <span class="text-secondary text-xs font-monospace d-block">
                    <%= individual_return >= 0 ? "+" : "" %><%= number_to_percentage(individual_percentage, precision: 2) %>
                  </span>
                </td>

                <!-- Portfolio Asset Weight Ratio Column Block -->
                <td class="text-center">
                  <span class="badge bg-light text-dark font-monospace border fw-bold px-2.5 py-1.5 rounded-2">
                    <%= number_to_percentage(portfolio_weight, precision: 1) %>
                  </span>
                </td>
                
                <!-- Action Handling Control Interface -->
                <td class="pe-4 text-end">
                  <div class="d-inline-flex gap-1">
                    <%= link_to "✏️ Edit", edit_coin_path(coin), class: "btn btn-sm btn-white border border-gray-300 text-dark px-2.5 py-1.5 shadow-xs rounded-2 hover-bg-light" %>
                    <%= button_to coin_path(coin), method: :delete, 
                                  data: { confirm: "Are you certain you want to erase this #{coin.name} entry block?" }, 
                                  class: "btn btn-sm btn-white text-danger border border-gray-300 px-2.5 py-1.5 shadow-xs rounded-2" do %>
                      🗑️ Delete
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                No active cryptocurrency profiles found in this wallet ledger structure. Click "Add New Asset" above to initialize entry details.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
