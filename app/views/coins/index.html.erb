<div class="container my-5">
  
  <!-- Section 1: Top Valuation KPI Banners -->
  <div class="row g-3 mb-4">
    <!-- Card 1: Net Asset Value -->
    <div class="col-12 col-md-4">
      <div class="card shadow-sm border border-light-subtle h-100">
        <div class="card-body p-3">
          <div class="text-secondary small text-uppercase fw-semibold tracking-wider mb-1">Net Asset Value</div>
          <div class="h3 mb-0 font-monospace fw-bold text-dark">
            $<%= number_with_delimiter(number_with_precision(@total_current_value, precision: 2)) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Total Cost Basis -->
    <div class="col-12 col-sm-6 col-md-4">
      <div class="card shadow-sm border border-light-subtle h-100">
        <div class="card-body p-3">
          <div class="text-secondary small text-uppercase fw-semibold tracking-wider mb-1">Total Cost Basis</div>
          <div class="h4 mb-0 font-monospace text-secondary-emphasis">
            $<%= number_with_delimiter(number_with_precision(@total_cost_basis, precision: 2)) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 3: Total Return (Profit/Loss) -->
    <div class="col-12 col-sm-6 col-md-4">
      <div class="card shadow-sm border border-light-subtle h-100">
        <div class="card-body p-3">
          <div class="text-secondary small text-uppercase fw-semibold tracking-wider mb-1">Total Return</div>
          <div class="h4 mb-0 font-monospace fw-semibold <%= @total_profit_loss >= 0 ? 'text-success' : 'text-danger' %>">
            <%= @total_profit_loss >= 0 ? '+' : '' %>$<%= number_with_delimiter(number_with_precision(@total_profit_loss, precision: 2)) %>
            <span class="small fw-normal ms-1">
             
              <%= @total_profit_loss >= 0 ? '+' : '' %><%= number_with_precision(@total_percentage_change, precision: 2) %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 2: Portfolio Distribution Visual Grid Container -->
  <div class="card shadow-sm border border-light-subtle mb-4">
    <div class="card-header bg-light-subtle py-3 border-bottom-0">
      <h3 class="h6 mb-0 text-secondary text-uppercase fw-semibold tracking-wider">Asset Allocation Weights</h3>
    </div>
    <div class="card-body pt-0 px-3 pb-3">
      <% if @coins.any? && @total_current_value > 0 %>
        <div class="row g-4 align-items-center">
          
          <!-- COLUMN 1: Responsive Chart.js Canvas Object -->
          <div class="col-12 col-md-4 d-flex justify-content-center py-3">
            <div style="width: 100%; max-width: 220px; max-height: 220px; position: relative;">
              <canvas id="portfolioDistributionChart"></canvas>
            </div>
          </div>

          <!-- COLUMN 2: Progress Bars & Metric Labels -->
          <div class="col-12 col-md-8">
            <div class="row row-cols-1 row-cols-sm-2 g-3">
              <% @portfolio_distribution.each_with_index do |asset, index| %>
                <% colors = ['bg-primary', 'bg-success', 'bg-info', 'bg-warning', 'bg-purple', 'bg-orange', 'bg-secondary'] %>
                <% bar_color = colors[index % colors.length] %>
                
                <div class="p-2 border rounded-3 bg-light-subtle shadow-xs">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-dark small">
                      <span class="d-inline-block rounded-circle me-1" style="width: 10px; height: 10px; background-color: <%= bar_color == 'bg-primary' ? '#0d6efd' : (bar_color == 'bg-success' ? '#198754' : (bar_color == 'bg-info' ? '#0dcaf0' : (bar_color == 'bg-warning' ? '#ffc107' : '#6f42c1'))) %>"></span>
                      <%= asset[:name] %> (<%= asset[:symbol] %>)
                    </span>
                    <span class="font-monospace text-secondary small fw-bold"><%= number_with_precision(asset[:percentage], precision: 1) %>%</span>
                  </div>
                  
                  <div class="progress" style="height: 6px;" role="progressbar" aria-label="<%= asset[:name] %> weight" aria-valuenow="<%= asset[:percentage] %>" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar <%= bar_color %> rounded" style="width: <%= asset[:percentage] %>%"></div>
                  </div>
                  <div class="text-muted font-monospace text-xs mt-1">
                    $<%= number_with_delimiter(number_with_precision(asset[:current_value], precision: 2)) %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

        </div>
      <% else %>
        <div class="text-center py-5 text-secondary small">
          No valuation tracking available until ledger items are added.
        </div>
      <% end %>
    </div>
  </div>

  <!-- Section Dashboard Header Elements -->
  <div class="row align-items-center justify-content-between g-3 mb-4">
    <div class="col-12 col-md-auto">
      <h1 class="h2 fw-extrabold text-dark tracking-tight mb-1">Portfolio Overview</h1>
      <p class="text-secondary small mb-0">Real-time valuation analytics generated via Rails 8 framework architecture</p>
    </div>
    <div class="col-12 col-md-auto">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <%= link_to "Add New Asset", new_coin_path, class: "btn btn-primary shadow-sm fw-semibold" %>
      </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
        <%# Uses the resource collection path helper matching our new routes format %>
        <%= button_to refresh_prices_coins_path, method: :get, class: "btn btn-white text-dark border border-gray-300 d-inline-flex align-items-center gap-2 px-3 py-2 shadow-xs fw-semibold rounded-2" do %>
          <span>🔄</span> Refresh Market Rates
        <% end %>
      </div>


  </div>

  <!-- YOUR CORE TRANSACTIONS TABLE LOOP STARTS IMMEDIATELY BELOW HERE -->

</div>

<!-- Dataset Core Injection Element for DOM Parsing -->
<%= content_tag :div, id: "portfolio-chart-data", 
      data: { 
        labels: @portfolio_distribution.map { |a| "#{a[:name]} holdings" },
        values: @portfolio_distribution.map { |a| a[:percentage].round(2) },
        valuations: @portfolio_distribution.map { |a| number_to_currency(a[:current_value]) }
      } do %>
<% end %>

<!-- Live Setup Script Bundle Pipeline -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener("turbo:load", function() {
    const dataEl = document.getElementById("portfolio-chart-data");
    if (!dataEl) return;

    const labels = JSON.parse(dataEl.dataset.labels);
    const values = JSON.parse(dataEl.dataset.values);
    const valuations = JSON.parse(dataEl.dataset.valuations);

    const ctx = document.getElementById('portfolioDistributionChart').getContext('2d');
    if (window.myPortfolioChart) { window.myPortfolioChart.destroy(); }

    window.myPortfolioChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: ['#0d6efd', '#198754', '#0dcaf0', '#ffc107', '#6f42c1', '#fd7e14', '#adb5bd'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                const idx = context.dataIndex;
                return ` ${valuations[idx]} (${values[idx]}%)`;
              }
            }
          }
        },
        cutout: '73%'
      }
    });
  });
</script>



  <!-- Flash Notification Banners Layout -->
  

  <!-- Section Dashboard Header Elements -->
  <div class="row align-items-center justify-content-between g-3 mb-5">
    
     <div class="col-12 col-md-auto">
      
    </div>
  </div>

  <!-- Macro Metric Portfolio Highlights Summary Cards -->
  <div class="row g-4 mb-5">
    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm bg-white rounded-3 p-4">
        <div class="text-uppercase text-secondary tracking-wider fw-bold small mb-2">Total Combined Cost</div>
        <div class="h2 fw-bold text-dark mb-0 font-monospace">
          <%# Protection Fix: Safely convert inputs to floats to prevent nil computation crashes %>
          <% @total_investment = @coins.sum { |c| c.amount_owned.to_f * c.cost_per_coin.to_f } %>
          <%= number_to_currency(@total_investment) %>
        </div>
      </div>
    </div>
    
    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm bg-white rounded-3 p-4">
        <div class="text-uppercase text-secondary tracking-wider fw-bold small mb-2">Current Value Index</div>
        <div class="h2 fw-bold text-primary mb-0 font-monospace">
          <% @current_portfolio_value = @coins.sum { |c| c.amount_owned.to_f * c.price.to_f } %>
          <%= number_to_currency(@current_portfolio_value) %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="card h-100 border-0 shadow-sm rounded-3 p-4 bg-light">
        <div class="text-uppercase text-secondary tracking-wider fw-bold small mb-2">Net Portfolio Returns</div>
        <div class="h2 fw-bold mb-0 font-monospace">
          <% @net_profit_loss = @current_portfolio_value - @total_investment %>
          <%= @net_profit_loss >= 0 ? "+" : "" %><%= number_to_currency(@net_profit_loss) %>
        </div>
      </div>
    </div>
  </div>

    <!-- 🟢 PLACE YOUR MONITORED ASSETS LEDGER TABLE CONTAINER HERE -->
  <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mt-4">
    <div class="card-header bg-white py-3 px-4 border-bottom border-light">
      <h5 class="mb-0 fw-bold text-dark">Monitored Assets Allocation Ledger</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-uppercase fw-bold small tracking-wider text-secondary border-bottom">
          <tr>
            <th class="ps-4 py-3">Asset Allocation</th>
            <th class="text-end">Market Capitalisation</th>
            <th class="text-end">Token Price</th>
            <th class="text-center">1h / 24h / 7d Trends</th>
            <th class="text-end">Quantity Owned</th>
            <th class="text-end">Holding Valuation</th>
            <th class="pe-4 text-end">Action Controls</th>
          </tr>
        </thead>
        <tbody class="text-sm">
          <% if @coins.any? %>
            <% @coins.each do |coin| %>
              <% total_value = coin.amount_owned.to_f * coin.price.to_f %>
              <tr>
                <td class="ps-4 py-3 fw-bold text-dark">
                  <span class="d-inline-flex align-items-center justify-content-center bg-dark text-white fw-bold rounded-2 px-2 py-1 text-xs font-monospace me-2">
                    <%= coin.symbol.presence || '?' %>
                  </span>
                  <%= coin.name %>
                </td>
                <td class="text-end text-secondary font-monospace">
                  $<%= number_to_human(coin.market_cap.to_f, precision: 2) %>
                </td>
                <td class="text-end fw-semibold text-dark font-monospace">
                  <%= number_to_currency(coin.price) %>
                </td>
                <td class="text-center">
                  <div class="d-inline-flex align-items-center gap-1 font-monospace text-xs fw-semibold px-2 py-1 rounded bg-light border">
                    <span class="<%= coin.percent_change_1h.to_f >= 0 ? 'text-success' : 'text-danger' %>">
                      <%= coin.percent_change_1h.to_f >= 0 ? '▲' : '▼' %> <%= coin.percent_change_1h || '0.0' %>%
                    </span>
                    <span class="text-muted opacity-50 px-0.5">/</span>
                    <span class="<%= coin.percent_change_24h.to_f >= 0 ? 'text-success' : 'text-danger' %>">
                      <%= coin.percent_change_24h || '0.0' %>%
                    </span>
                  </div>
                </td>
                <td class="text-end text-dark font-monospace">
                  <%= number_with_delimiter(coin.amount_owned) %>
                </td>
                <td class="text-end text-dark font-monospace fw-bold">
                  <%= number_to_currency(total_value) %>
                </td>
                <td class="text-end pe-4">
                  <div class="d-flex justify-content-end gap-2">
                    <!-- Edit Link -->
                    <%= link_to "Edit", edit_coin_path(coin), class: "btn btn-sm btn-outline-secondary fw-semibold px-3" %>
                    
                    <!-- Rails 8 Native Delete Button -->
                    <%= button_to "Delete", coin_path(coin), 
                                  method: :delete, 
                                  class: "btn btn-sm btn-outline-danger fw-semibold px-3", 
                                  form: { data: { turbo_confirm: "Are you sure you want to permanently remove #{coin.name} from your ledger?" } } %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-5 text-secondary">No assets tracked yet. Click Add New Asset to begin!</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div> <!-- Main view opening container div tag wrapper ends safely closed here -->

<!-- Dataset Core Injection Element for DOM Parsing -->
<%= content_tag :div, id: "portfolio-chart-data", 
      data: { 
        labels: @portfolio_distribution.map { |a| "#{a[:name]} holdings" },
        values: @portfolio_distribution.map { |a| a[:percentage].round(2) },
        valuations: @portfolio_distribution.map { |a| number_to_currency(a[:current_value]) }
      } do %>
<% end %>

<!-- 🛠️ FIXED SOURCE LINK PIPELINE BUNDLE -->
<script>
  function initPortfolioChart() {
    const dataEl = document.getElementById("portfolio-chart-data");
    const canvasEl = document.getElementById('portfolioDistributionChart');
    if (!dataEl || !canvasEl) return;

    const labels = JSON.parse(dataEl.dataset.labels);
    const values = JSON.parse(dataEl.dataset.values);
    const valuations = JSON.parse(dataEl.dataset.valuations);

    const ctx = canvasEl.getContext('2d');
    if (window.myPortfolioChart) { window.myPortfolioChart.destroy(); }

    window.myPortfolioChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: ['#0d6efd', '#198754', '#0dcaf0', '#ffc107', '#6f42c1', '#fd7e14', '#adb5bd'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                const idx = context.dataIndex;
                return ` ${valuations[idx]} (${values[idx]}%)`;
              }
            }
          }
        },
        cutout: '73%'
      }
    });
  }

  // Rails 8 Native Navigation Hooks
  document.addEventListener("turbo:load", initPortfolioChart);
  if (document.readyState !== "loading") {
    initPortfolioChart();
  } else {
    document.addEventListener("DOMContentLoaded", initPortfolioChart);
  }
</script>
